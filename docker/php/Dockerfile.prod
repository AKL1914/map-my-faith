FROM php:8.2-fpm

# Install OS-level libraries & PHP build dependencies
RUN apt-get update && apt-get install -y \
    zip unzip curl libpng-dev libjpeg-dev libfreetype6-dev libonig-dev libxml2-dev \
    supervisor \
    && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd xml

# Install and enable phpredis
RUN pecl install redis && docker-php-ext-enable redis

# Copy Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Copy Supervisor config
COPY docker/php/supervisord.prod.conf /etc/supervisor/conf.d/supervisord.conf

# Set working dir
WORKDIR /var/www/html

# Copy the Laravel app
COPY ./laravel-app /var/www/html

# Install *production* PHP deps only
RUN composer install --no-dev --optimize-autoloader && \
    chown -R www-data:www-data /var/www/html

# Run Supervisor to manage PHP-FPM + queues
CMD ["/usr/bin/supervisord"]